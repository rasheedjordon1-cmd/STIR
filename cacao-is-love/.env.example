# CACAO IS LOVE — the two settings that turn the store on.
#
# Both are read at build time and are LAUNCH BLOCKERS until set:
#   · without CHECKOUT_URL the CHECKOUT button renders disabled
#   · without SIGNUP_URL the whole newsletter section does not render
#
# Set them in Netlify under Site settings → Environment variables, then redeploy.

# Where CHECKOUT sends the customer (Shopify permalink, Stripe payment link, …)
NEXT_PUBLIC_CHECKOUT_URL=

# Endpoint the email form POSTs {"email": "..."} to.
# Return 200 on success, 409 if already subscribed, any other status on failure.
NEXT_PUBLIC_SIGNUP_URL=

# Optional: set when a custom domain replaces cacaoislove.netlify.app.
# Drives canonical URLs, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=
