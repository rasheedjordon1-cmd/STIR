# ==========================================================================
# SPICEMART — environment
# The prototype runs with NONE of these set: it falls back to the mock
# commerce adapter and renders an honest "checkout not connected" state.
# Copy to .env.local only when connecting a real Shopify store.
# ==========================================================================

# Shopify Storefront API. Read server-side only — deliberately NOT prefixed
# with NEXT_PUBLIC_, so nothing is bundled into the client.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-07
